{
  "name": "task2_playwright",
  "version": "1.0.0",
  "description": "Playwright UI automation framework for Redmine with POM and Allure",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "allure",
    "pom"
  ],
  "author": "Ruslan Bolduma",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2"
  }
}
